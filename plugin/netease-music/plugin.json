{
  "schemaVersion": 1,
  "apiVersion": 1,
  "minHostVersion": "0.1.0",
  "id": "mono-native-wasm-netease",
  "name": "网易云音乐",
  "version": "1.0.0",
  "kind": "music",
  "author": "Mono",
  "description": "搜索并播放网易云音乐，默认使用超清母带音质。",
  "capabilities": [
    "search",
    "play",
    "lyrics"
  ],
  "permissions": [
    "network"
  ],
  "configSchema": {
    "fields": [
      {
        "defaultValue": "jymaster",
        "key": "defaultQuality",
        "label": "默认音质",
        "options": [
          {
            "label": "标准音质",
            "value": "standard"
          },
          {
            "label": "极高音质",
            "value": "exhigh"
          },
          {
            "label": "无损音质",
            "value": "lossless"
          },
          {
            "label": "Hi-Res",
            "value": "hires"
          },
          {
            "label": "高清环绕声",
            "value": "jyeffect"
          },
          {
            "label": "沉浸环绕声",
            "value": "sky"
          },
          {
            "label": "超清母带",
            "value": "jymaster"
          }
        ],
        "type": "select"
      }
    ]
  },
  "entry": {
    "wasm": "dist/plugin.wasm"
  },
  "contributions": {}
}
