{
  "id": "betterlyrics",
  "name": "BetterLyrics 歌词",
  "version": "1.2.0",
  "kind": "lyrics-renderer",
  "runtime": "module",
  "entry": "./renderer.mjs",
  "author": "Mono contributors · Based on jayfunc/BetterLyrics",
  "description": "BetterLyrics 歌词页面移植：逐字高亮、长音发光与浮动、聚焦滚动、封面流动背景及窄屏布局。",
  "updatedAt": "2026-09-24",
  "capabilities": [
    "lyrics-renderer"
  ],
  "permissions": [],
  "configSchema": {
    "fields": [
      {
        "key": "verticalOffset",
        "label": "竖排歌词上下位置",
        "type": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "fontSize",
        "label": "歌词字号",
        "type": "range",
        "min": 20,
        "max": 72,
        "step": 1,
        "defaultValue": 40
      },
      {
        "key": "lineGap",
        "label": "歌词行间距",
        "type": "range",
        "min": 0,
        "max": 1.5,
        "step": 0.05,
        "defaultValue": 0.55
      },
      {
        "key": "alignment",
        "label": "歌词对齐",
        "type": "select",
        "defaultValue": "left",
        "options": [
          {
            "label": "左对齐",
            "value": "left"
          },
          {
            "label": "居中",
            "value": "center"
          }
        ]
      },
      {
        "key": "backgroundMode",
        "label": "背景模式",
        "type": "select",
        "defaultValue": "fluid",
        "options": [
          {
            "label": "封面流动",
            "value": "fluid"
          },
          {
            "label": "封面模糊",
            "value": "blur"
          },
          {
            "label": "跟随播放器",
            "value": "host"
          }
        ]
      },
      {
        "key": "blur",
        "label": "远处歌词模糊",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "glow",
        "label": "逐字辉光",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "float",
        "label": "逐字浮动",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "scale",
        "label": "歌词缩放",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "showCover",
        "label": "显示封面",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "lyricStyle",
        "label": "歌词样式",
        "defaultValue": "standard",
        "type": "select",
        "options": [
          {
            "value": "standard",
            "label": "标准"
          },
          {
            "value": "glow",
            "label": "辉光上浮"
          },
          {
            "value": "vertical",
            "label": "竖排歌词"
          },
          {
            "value": "perspective",
            "label": "3D 透视"
          }
        ]
      },
      {
        "key": "tiltAngle",
        "min": -45,
        "defaultValue": 25,
        "step": 1,
        "max": 45,
        "label": "透视角度",
        "type": "range"
      },
      {
        "key": "glowAmount",
        "min": 0,
        "defaultValue": 8,
        "step": 1,
        "max": 24,
        "label": "辉光强度",
        "type": "range"
      },
      {
        "key": "floatAmount",
        "min": 0,
        "defaultValue": 8,
        "step": 1,
        "max": 16,
        "label": "上浮幅度",
        "type": "range"
      },
      {
        "key": "glowScope",
        "label": "辉光范围",
        "defaultValue": "long",
        "type": "select",
        "options": [
          {
            "value": "long",
            "label": "仅长音"
          },
          {
            "value": "all",
            "label": "行首到当前字"
          }
        ]
      }
    ]
  }
}
