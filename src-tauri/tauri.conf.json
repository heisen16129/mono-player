{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mono Player",
  "version": "0.1.0",
  "identifier": "com.local.mono-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run miot:bundle && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mono Player",
        "width": 1120,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 680,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/miot/dist/service.mjs": "miot/service.mjs",
      "../plugins/miot/dist/web/": "miot/web/",
      "../plugins/miot/dist/node.exe": "miot/node.exe",
      "../plugins/miot/dist/ffmpeg.exe": "miot/ffmpeg.exe"
    }
  }
}
