(function installMonoMineradioOriginalAdapter() {
  var state = {
    trackKey: '',
    coverKey: '',
    backgroundKey: '',
    lyricsKey: '',
    queueKey: '',
    surfaceReady: false,
    audioFrameSequence: 0,
    audioFrameAt: 0,
    audioFrameDurationMs: 1000 / 30,
    sharedColorBackCover: false,
    sampleRate: 44100,
    mainFrequencyPrevious: new Uint8Array(FFT_SIZE / 2),
    mainFrequencyCurrent: new Uint8Array(FFT_SIZE / 2),
    beatFrequencyPrevious: new Uint8Array(BEAT_FFT_SIZE / 2),
    beatFrequencyCurrent: new Uint8Array(BEAT_FFT_SIZE / 2),
    timePrevious: new Uint8Array(FFT_SIZE),
    timeCurrent: new Uint8Array(FFT_SIZE),
  };
  state.timePrevious.fill(128);
  state.timeCurrent.fill(128);
  var hostClock = {
    currentTime: 0,
    duration: 0,
    paused: true,
    ended: false,
    playbackRate: 1,
    volume: 1,
    muted: false,
    src: 'mono://active-track',
    currentSrc: 'mono://active-track',
    readyState: 4,
    networkState: 1,
    addEventListener: function () {},
    removeEventListener: function () {},
    dispatchEvent: function () { return true; },
    play: function () { this.paused = false; return Promise.resolve(); },
    pause: function () { this.paused = true; },
  };

  function keyOf(value) {
    try { return JSON.stringify(value); } catch (error) { return String(value || ''); }
  }

  function setText(id, value) {
    var element = document.getElementById(id);
    if (element) element.textContent = value || '';
  }

  function clamp(value, min, max) {
    return Math.max(min, Math.min(max, value));
  }

  function normalizedPcmSamples(input, size) {
    var sourceSamples = input instanceof Float32Array ? input : new Float32Array(input || []);
    var result = new Float32Array(size);
    if (!sourceSamples.length) return result;
    if (sourceSamples.length === size) {
      result.set(sourceSamples);
      return result;
    }
    if (size === 1 || sourceSamples.length === 1) {
      result.fill(Number(sourceSamples[0]) || 0);
      return result;
    }
    var sourceScale = (sourceSamples.length - 1) / (size - 1);
    for (var i = 0; i < size; i++) {
      var sourcePosition = i * sourceScale;
      var left = Math.floor(sourcePosition);
      var right = Math.min(sourceSamples.length - 1, left + 1);
      var mix = sourcePosition - left;
      result[i] = sourceSamples[left] * (1 - mix) + sourceSamples[right] * mix;
    }
    return result;
  }

  function fftFrequencyBytes(samples) {
    var size = samples.length;
    var real = new Float32Array(size);
    var imaginary = new Float32Array(size);
    for (var i = 0; i < size; i++) {
      var windowValue = 0.5 * (1 - Math.cos((2 * Math.PI * i) / Math.max(1, size - 1)));
      real[i] = clamp(Number(samples[i]) || 0, -1, 1) * windowValue;
    }
    for (var index = 1, reversed = 0; index < size; index++) {
      var bit = size >> 1;
      while (reversed & bit) {
        reversed ^= bit;
        bit >>= 1;
      }
      reversed ^= bit;
      if (index < reversed) {
        var swap = real[index];
        real[index] = real[reversed];
        real[reversed] = swap;
      }
    }
    for (var length = 2; length <= size; length <<= 1) {
      var angle = (-2 * Math.PI) / length;
      var stepReal = Math.cos(angle);
      var stepImaginary = Math.sin(angle);
      for (var start = 0; start < size; start += length) {
        var rotationReal = 1;
        var rotationImaginary = 0;
        for (var offset = 0; offset < length / 2; offset++) {
          var even = start + offset;
          var odd = even + length / 2;
          var oddReal = real[odd] * rotationReal - imaginary[odd] * rotationImaginary;
          var oddImaginary = real[odd] * rotationImaginary + imaginary[odd] * rotationReal;
          real[odd] = real[even] - oddReal;
          imaginary[odd] = imaginary[even] - oddImaginary;
          real[even] += oddReal;
          imaginary[even] += oddImaginary;
          var nextRotationReal = rotationReal * stepReal - rotationImaginary * stepImaginary;
          rotationImaginary = rotationReal * stepImaginary + rotationImaginary * stepReal;
          rotationReal = nextRotationReal;
        }
      }
    }
    var result = new Uint8Array(size / 2);
    for (var bin = 0; bin < result.length; bin++) {
      var magnitude = Math.max(1e-8, (2 * Math.hypot(real[bin], imaginary[bin])) / size);
      var decibels = 20 * Math.log10(magnitude);
      result[bin] = Math.round(clamp(((decibels + 100) / 70) * 255, 0, 255));
    }
    return result;
  }

  function smoothFrequency(raw, current, smoothing) {
    var result = new Uint8Array(current.length);
    for (var i = 0; i < result.length; i++) {
      result[i] = Math.round(current[i] * smoothing + raw[i] * (1 - smoothing));
    }
    return result;
  }

  function timeDomainBytes(samples) {
    var result = new Uint8Array(samples.length);
    for (var i = 0; i < result.length; i++) {
      result[i] = Math.round(128 + clamp(samples[i], -1, 1) * 127);
    }
    return result;
  }

  function copyInterpolated(previous, current, target) {
    var elapsed = performance.now() - state.audioFrameAt;
    var ratio = clamp(elapsed / Math.max(1, state.audioFrameDurationMs), 0, 1);
    ratio = ratio * ratio * (3 - 2 * ratio);
    var count = Math.min(target.length, previous.length, current.length);
    for (var i = 0; i < count; i++) {
      target[i] = Math.round(previous[i] + (current[i] - previous[i]) * ratio);
    }
    if (count < target.length) target.fill(0, count);
  }

  function createPcmAnalyser(frequencyPrevious, frequencyCurrent, smoothing) {
    return {
      fftSize: FFT_SIZE,
      frequencyBinCount: FFT_SIZE / 2,
      smoothingTimeConstant: smoothing,
      minDecibels: -100,
      maxDecibels: -30,
      getByteFrequencyData: function (target) {
        copyInterpolated(frequencyPrevious(), frequencyCurrent(), target);
      },
      getByteTimeDomainData: function (target) {
        copyInterpolated(state.timePrevious, state.timeCurrent, target);
      },
      connect: function () { return this; },
      disconnect: function () {},
    };
  }

  function installHostPcmAnalyser() {
    audioCtx = {
      sampleRate: state.sampleRate,
      state: 'running',
      currentTime: 0,
      destination: {},
      resume: function () { this.state = 'running'; return Promise.resolve(); },
      close: function () { this.state = 'closed'; return Promise.resolve(); },
    };
    analyser = createPcmAnalyser(
      function () { return state.mainFrequencyPrevious; },
      function () { return state.mainFrequencyCurrent; },
      0.58
    );
    beatAnalyser = createPcmAnalyser(
      function () { return state.beatFrequencyPrevious; },
      function () { return state.beatFrequencyCurrent; },
      0.10
    );
    source = {
      context: audioCtx,
      connect: function () { return this; },
      disconnect: function () {},
    };
    audioSourceMedia = hostClock;
    gainNode = null;
    analysisSinkNode = { disconnect: function () {} };
    audioReady = true;
  }

  function revealPluginVisuals() {
    if (!uniforms) return;
    if (uniforms.uAlpha) uniforms.uAlpha.value = 1;
    if (uniforms.uLoading) uniforms.uLoading.value = 0;
  }

  function syncOriginalWindowState() {
    window.audio = hostClock;
    window.currentIdx = currentIdx;
    window.frequencyData = frequencyData;
    window.fx = fx;
    window.playing = playing;
    window.playlist = playlist;
    window.playQueue = playQueue;
    window.stageLyrics = stageLyrics;
    window.coverUrlWithSize = coverUrlWithSize;
    window.songCoverSrc = songCoverSrc;
    window.lyricPaletteColorToHex = lyricPaletteColorToHex;
  }

  function forcePlayerSurface() {
    if (state.surfaceReady) return;
    state.surfaceReady = true;
    try { if (typeof dismissSplash === 'function') dismissSplash({ instant: true }); } catch (error) {}
    try { if (typeof applyDiyMode === 'function') applyDiyMode(true, { save: false }); } catch (error) {}
    var splash = document.getElementById('splash');
    if (splash) splash.style.display = 'none';
    document.body.classList.remove('splash-active', 'splash-revealing');
    try { if (typeof switchPlaybackVisualToEmily === 'function') switchPlaybackVisualToEmily(); } catch (error) {}
    var emptyHome = document.getElementById('empty-home');
    if (emptyHome) emptyHome.style.display = 'none';
    installHostPcmAnalyser();
    revealPluginVisuals();
    syncOriginalWindowState();
  }

  function applyTrack(payload) {
    var song = payload.track;
    if (!song) return;
    var nextKey = keyOf([song.id, song.name, song.artist, song.album]);
    if (nextKey !== state.trackKey) {
      state.trackKey = nextKey;
      setText('thumb-title', song.name);
      setText('thumb-artist', song.artist);
      if (typeof updateControlTrackInfo === 'function') updateControlTrackInfo(song);
      var thumbWrap = document.getElementById('thumb-wrap');
      if (thumbWrap) thumbWrap.classList.add('visible');
      currentLocalSong = song;
    }
    var nextCoverKey = String(song.cover || '');
    if (nextCoverKey !== state.coverKey) {
      state.coverKey = nextCoverKey;
      var coverOptions = { noCoverTransition: !state.coverKey, deferHeavy: false, coverKey: nextCoverKey };
      if (/^data:image\//i.test(nextCoverKey)) applyCoverDataUrl(nextCoverKey, coverOptions);
      else if (nextCoverKey) loadCoverFromUrl(nextCoverKey, coverOptions);
      else loadCoverFromUrl('', coverOptions);
    }
    revealPluginVisuals();
  }

  function applyQueue(payload) {
    var nextQueueKey = keyOf(payload.queue.map(function (song) {
      return [song.id, song.name, song.artist, song.cover, song.duration];
    }));
    var indexChanged = currentIdx !== payload.activeIndex;
    if (nextQueueKey === state.queueKey && !indexChanged) return;
    state.queueKey = nextQueueKey;
    playQueue = payload.queue.slice();
    currentIdx = payload.activeIndex;
    syncOriginalWindowState();
    queueViewTab = 'queue';
    try { if (typeof safeRenderQueuePanel === 'function') safeRenderQueuePanel('mono-context', { animate: false, scrollCurrent: false, deferWhenHidden: false }); } catch (error) {}
    try { if (typeof renderMiniQueuePanel === 'function') renderMiniQueuePanel({ scrollCurrent: false }); } catch (error) {}
  }

  function applyLyrics(payload) {
    var lyricPayload = payload.lines || { lines: [], karaoke: false, timingSource: 'none' };
    var nextLyricsKey = keyOf(lyricPayload.lines.map(function (line) {
      return [line.t, line.text, line.words && line.words.length];
    }));
    if (nextLyricsKey === state.lyricsKey) return;
    state.lyricsKey = nextLyricsKey;
    if (typeof setOriginalLyricsState === 'function') {
      setOriginalLyricsState(lyricPayload.lines, lyricPayload.karaoke, lyricPayload.timingSource, [], 'none');
    }
    if (typeof applyLyricsState === 'function') {
      applyLyricsState(lyricPayload.lines, lyricPayload.karaoke, lyricPayload.timingSource, [], 'none', { reason: 'mono-context' });
    }
  }

  function applyPlayback(payload) {
    audio = hostClock;
    audioReady = true;
    hostClock.currentTime = payload.currentTime;
    hostClock.duration = payload.duration;
    hostClock.paused = !payload.playing;
    hostClock.ended = payload.duration > 0 && payload.currentTime >= payload.duration;
    hostClock.playbackRate = payload.playbackRate;
    hostClock.volume = payload.volume;
    hostClock.muted = payload.muted;
    playing = payload.playing;
    playToggleBusy = false;
    syncOriginalWindowState();
    if (typeof setPlayIcon === 'function') setPlayIcon(payload.playing);
    if (typeof updatePlaybackProgressUi === 'function') updatePlaybackProgressUi();
    var slider = document.getElementById('volume-slider');
    var value = document.getElementById('volume-value');
    if (slider && document.activeElement !== slider) slider.value = String(payload.volume);
    if (value) value.textContent = Math.round(payload.volume * 100) + '%';
    var heart = document.getElementById('heart-btn');
    if (heart) heart.classList.toggle('liked', payload.favorite);
  }

  function applySharedBackground(payload) {
    var background = payload.background || {};
    var source = background.source || 'cover';
    var sharedMedia = source === 'media' || source === 'wallpaper';
    var mediaUrl = source === 'cover'
      ? String(payload.track && payload.track.cover || '')
      : (sharedMedia ? String(background.mediaUrl || '') : '');
    var isVideo = sharedMedia && background.mediaKind === 'video' && Boolean(mediaUrl);
    var nativeScene = source === 'wallpaper' && background.wallpaperProjectType === 'scene';
    var opacity = Math.min(1, Math.max(0, Number(background.opacity == null ? .72 : background.opacity)));
    var blur = Math.min(60, Math.max(0, Number(background.blur == null ? 0 : background.blur)));
    var windowOpacity = Math.min(1, Math.max(0, Number(background.windowOpacity == null ? 1 : background.windowOpacity)));
    var shell = document.getElementById('desktop-window-shell');
    var layer = document.getElementById('custom-bg');
    if (!shell || !layer) return;
    var baseColor = source === 'color' ? String(background.color || '#000000') : '#000000';
    var colorMatch = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(baseColor);
    baseColor = colorMatch ? baseColor : '#000000';
    shell.setAttribute('data-mono-shared-background', source);
    document.body.setAttribute('data-mono-shared-background', source);
    shell.classList.toggle('native-wallpaper-scene', nativeScene);
    document.body.classList.toggle('native-wallpaper-scene', nativeScene);
    shell.style.setProperty('--mono-shared-bg-position', Number(background.positionX == null ? 50 : background.positionX) + '% ' + Number(background.positionY == null ? 50 : background.positionY) + '%');
    shell.style.setProperty('--mono-shared-bg-scale', String(Math.min(2, Math.max(.5, Number(background.scale) || 1))));
    shell.style.setProperty('--mono-shared-bg-blur', blur + 'px');
    shell.style.setProperty('--mono-shared-bg-blur-scale', String(blur / 500));
    var nextBackgroundKey = keyOf([
      source, baseColor, mediaUrl, isVideo, nativeScene, opacity, blur, windowOpacity,
      background.positionX, background.positionY, background.scale,
    ]);
    var currentMedia = fx && fx.backgroundMedia;
    var expectedColorRgb = colorMatch
      ? [parseInt(colorMatch[1], 16), parseInt(colorMatch[2], 16), parseInt(colorMatch[3], 16)].join(',')
      : '0,0,0';
    var appliedColorRgb = getComputedStyle(document.documentElement)
      .getPropertyValue('--custom-bg-color-rgb')
      .replace(/\s+/g, '');
    var originalBackgroundApplied = source !== 'color' || (
      appliedColorRgb === expectedColorRgb
      && document.body.classList.contains('custom-background-override')
      && document.body.classList.contains('custom-background-flat')
      && Boolean(backCoverGroup)
    );
    var originalBackgroundMatches = Boolean(fx)
      && String(fx.backgroundColor || '').toLowerCase() === baseColor.toLowerCase()
      && Boolean(fx.backgroundColorMode === 'custom' || fx.backgroundColorCustom) === (source === 'color')
      && Boolean(fx.backgroundAlbumCover) === (source === 'cover')
      && Number(fx.windowBackgroundOpacity == null ? 1 : fx.windowBackgroundOpacity) === windowOpacity
      && (source !== 'color' || !currentMedia)
      && (!sharedMedia || !mediaUrl || Boolean(
        currentMedia
        && currentMedia.type === (isVideo ? 'video' : 'image')
        && String(currentMedia.src || '') === mediaUrl
      ))
      && originalBackgroundApplied;
    if (nextBackgroundKey === state.backgroundKey && originalBackgroundMatches) return;
    state.backgroundKey = nextBackgroundKey;
    fx.backgroundColor = baseColor;
    fx.backgroundColorMode = source === 'color' ? 'custom' : 'cover';
    fx.backgroundColorCustom = source === 'color';
    fx.backgroundAlbumCover = source === 'cover';
    fx.backgroundImage = '';
    fx.backgroundMedia = sharedMedia && mediaUrl
      ? { type: isVideo ? 'video' : 'image', src: mediaUrl }
      : null;
    fx.backgroundOpacity = opacity;
    fx.windowBackgroundOpacity = windowOpacity;
    fx.backgroundMediaCropX = Math.min(100, Math.max(0, Number(background.positionX == null ? 50 : background.positionX)));
    fx.backgroundMediaCropY = Math.min(100, Math.max(0, Number(background.positionY == null ? 50 : background.positionY)));
    fx.backgroundMediaZoom = Math.min(2.8, Math.max(1, Number(background.scale) || 1));
    if (typeof applyCustomBackground === 'function') applyCustomBackground();
    if (source === 'color') {
      if (!backCoverGroup && typeof createBackCoverLayer === 'function') {
        createBackCoverLayer();
        state.sharedColorBackCover = true;
      }
      var activeCoverCanvas = typeof coverTex !== 'undefined'
        && coverTex
        && coverTex.image
        && typeof coverTex.image.getContext === 'function'
        ? coverTex.image
        : null;
      if (state.sharedColorBackCover && activeCoverCanvas && typeof refreshBackCoverColorsFromCanvas === 'function') {
        refreshBackCoverColorsFromCanvas(activeCoverCanvas);
      }
    } else if (state.sharedColorBackCover) {
      state.sharedColorBackCover = false;
      if (!fx.backCover && typeof destroyBackCoverLayer === 'function') destroyBackCoverLayer();
    }
  }

  window.__monoMineradioOriginal = {
    invokeInlineHandler: function (expression, event, element) {
      if (!expression) return;
      return (function () { return eval(expression); }).call(element);
    },
    selectSettingsTab: function (tab) {
      if (typeof setFxPanelTab === 'function') setFxPanelTab(tab);
    },
    setContext: function (payload) {
      forcePlayerSurface();
      applyQueue(payload);
      applyTrack(payload);
      applyLyrics(payload);
      applyPlayback(payload);
      applySharedBackground(payload);
    },
    setAudioFrame: function (frame) {
      if (!frame || !frame.samples) return;
      var sequence = Number(frame.sequence) || 0;
      if (sequence && sequence === state.audioFrameSequence) return;
      var sourceSamples = frame.samples instanceof Float32Array
        ? frame.samples
        : new Float32Array(frame.samples);
      if (!sourceSamples.length) return;
      var sampleRate = Math.max(8000, Number(frame.sampleRate) || 44100);
      var pcm = normalizedPcmSamples(sourceSamples, FFT_SIZE);
      var rawFrequency = fftFrequencyBytes(pcm);
      state.audioFrameSequence = sequence || state.audioFrameSequence + 1;
      state.sampleRate = sampleRate;
      state.audioFrameDurationMs = (sourceSamples.length / sampleRate) * 1000;
      state.mainFrequencyPrevious.set(state.mainFrequencyCurrent);
      state.beatFrequencyPrevious.set(state.beatFrequencyCurrent);
      state.timePrevious.set(state.timeCurrent);
      state.mainFrequencyCurrent = smoothFrequency(rawFrequency, state.mainFrequencyCurrent, 0.58);
      state.beatFrequencyCurrent = smoothFrequency(rawFrequency, state.beatFrequencyCurrent, 0.10);
      state.timeCurrent = timeDomainBytes(pcm);
      state.audioFrameAt = performance.now();
      if (audioCtx) audioCtx.sampleRate = sampleRate;
      syncOriginalWindowState();
    },
    getClock: function () { return hostClock; },
    showSettings: function () { if (typeof toggleFxPanel === 'function') toggleFxPanel(true); },
    debug: function () {
      return {
        preset: fx && fx.preset,
        camera: camera ? {
          x: camera.position.x,
          y: camera.position.y,
          z: camera.position.z,
          rx: camera.rotation.x,
          ry: camera.rotation.y,
          rz: camera.rotation.z,
        } : null,
        orbit: orbit ? {
          theta: orbit.theta,
          phi: orbit.phi,
          radius: orbit.radius,
          userTheta: orbit.userTheta,
          userPhi: orbit.userPhi,
        } : null,
        stageRotation: gestureRotation ? {
          x: gestureRotation.x,
          y: gestureRotation.y,
        } : null,
        hasCover: uniforms && uniforms.uHasCover ? uniforms.uHasCover.value : 0,
        particleAlpha: uniforms && uniforms.uAlpha ? uniforms.uAlpha.value : 0,
        particleVisible: particles ? particles.visible : false,
        particleCount: particles && particles.geometry && particles.geometry.getAttribute('position')
          ? particles.geometry.getAttribute('position').count
          : 0,
        audioFrameSequence: state.audioFrameSequence,
        sampleRate: state.sampleRate,
      };
    },
  };
  forcePlayerSurface();
})();
