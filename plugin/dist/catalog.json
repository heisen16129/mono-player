  {
    "schemaVersion": 1,
    "apiVersion": 1,
    "minHostVersion": "0.1.0",
    "id": "mono-wasm-stem-separation",
    "name": "人声 / 伴奏分离",
    "version": "1.1.0",
    "kind": "tool",
    "author": "Mono Player",
    "description": "使用本地 Demucs 将音乐导出为人声与伴奏 WAV。支持一键准备组件、自动识别已有环境，无需手动配置。",
    "capabilities": [
      "stem-separation"
    ],
    "permissions": [
      "service.run",
      "network",
      "files.choose",
      "files.reveal"
    ],
    "configSchema": {
      "fields": [
        {
          "key": "pythonPath",
          "label": "自定义分离环境（可选）",
          "placeholder": "自动识别，无需填写；高级用户可指定 Python 路径",
          "type": "text"
        },
        {
          "defaultValue": "auto",
          "key": "device",
          "label": "计算设备",
          "options": [
            {
              "label": "自动选择",
              "value": "auto"
            },
            {
              "label": "CPU",
              "value": "cpu"
            },
            {
              "label": "NVIDIA GPU",
              "value": "cuda"
