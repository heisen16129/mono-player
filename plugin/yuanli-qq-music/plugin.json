{
  "schemaVersion": 1,
  "apiVersion": 1,
  "minHostVersion": "0.1.0",
  "id": "mono-native-wasm-yuanli-qq",
  "name": "元力QQ",
  "version": "1.0.0",
  "kind": "music",
  "author": "Mono",
  "description": "搜索并播放 QQ 音乐，支持多音质和多格式歌词。",
  "capabilities": [
    "search",
    "play",
    "lyrics"
  ],
  "permissions": [
    "network"
  ],
  "configSchema": {
    "fields": [
      {
        "defaultValue": "320k",
        "key": "defaultQuality",
        "label": "默认音质",
        "options": [
          {
            "label": "标准音质",
            "value": "128k"
          },
          {
            "label": "高品音质",
            "value": "320k"
          },
          {
            "label": "无损音质",
            "value": "flac"
          }
        ],
        "type": "select"
      }
    ]
  },
  "entry": {
    "wasm": "dist/plugin.wasm"
  },
  "contributions": {}
}
