{
  "id": "fanlyrics",
  "name": "扇形歌词",
  "version": "1.1.1",
  "kind": "lyrics-renderer",
  "runtime": "module",
  "entry": "./renderer.mjs",
  "author": "Mono contributors · Based on jayfunc/BetterLyrics",
  "description": "独立扇形歌词：统一圆弧排布、左侧弧形大封面与逐字高亮。",
  "updatedAt": "2026-09-24",
  "capabilities": [
    "lyrics-renderer"
  ],
  "permissions": [],
  "configSchema": {
    "fields": [
      {
        "key": "fontSize",
        "label": "歌词字号",
        "type": "range",
        "min": 20,
        "max": 72,
        "step": 1,
        "defaultValue": 40
      },
      {
        "key": "lineGap",
        "label": "歌词行间距",
        "type": "range",
        "min": 0,
        "max": 1.5,
        "step": 0.05,
        "defaultValue": 0.55
      },
      {
        "key": "blur",
        "label": "远处歌词模糊",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "scale",
        "label": "远处歌词缩放",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "showCover",
        "label": "显示封面",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "fanAngle",
        "min": -45,
        "defaultValue": 30,
        "step": 1,
        "max": 45,
        "label": "扇形角度",
        "type": "range"
      }
    ]
  }
}
