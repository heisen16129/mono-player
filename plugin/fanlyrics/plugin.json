{
  "schemaVersion": 1,
  "apiVersion": 1,
  "minHostVersion": "0.1.0",
  "id": "fanlyrics",
  "name": "扇形歌词",
  "version": "1.1.1",
  "kind": "lyrics-renderer",
  "author": "Mono contributors · Based on jayfunc/BetterLyrics",
  "description": "独立扇形歌词：统一圆弧排布、左侧弧形大封面与逐字高亮。",
  "capabilities": [
    "lyrics-renderer"
  ],
  "configSchema": {
    "fields": [
      {
        "key": "fontSize",
        "label": "歌词字号",
        "type": "range",
        "min": 20,
        "max": 72,
        "step": 1,
        "defaultValue": 40
      },
      {
        "key": "lineGap",
        "label": "歌词行间距",
        "type": "range",
        "min": 0,
        "max": 1.5,
        "step": 0.05,
        "defaultValue": 0.55
      },
      {
        "key": "blur",
        "label": "远处歌词模糊",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "scale",
        "label": "远处歌词缩放",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "showCover",
        "label": "显示封面",
        "type": "switch",
        "defaultValue": true
      },
      {
        "key": "fanAngle",
        "min": -45,
        "defaultValue": 30,
        "step": 1,
        "max": 45,
        "label": "扇形角度",
        "type": "range"
      }
    ]
  },
  "entry": {
    "renderer": "ui/renderer.mjs"
  },
  "permissions": [
    "player.read",
    "player.control",
    "lyrics.read",
    "artwork.read",
    "favorites.read",
    "favorites.write",
    "lyrics.write"
  ],
  "contributions": {}
}
